# =============================================================
#  Shop-Konfiguration  —  Werte hier anpassen, dann `docker compose up -d --build`
# =============================================================

# --- Datenbank ---
DB_USER=shop
DB_PASSWORD=shop_secret
DB_NAME=shopdb

# --- Admin / Auth ---
ADMIN_USER=admin
ADMIN_PASSWORD=admin123
JWT_SECRET=bitte-hier-ein-langes-zufaelliges-secret-eintragen

# Geheimer URL-Pfad für die Admin-Seite. NICHT "/admin" lassen!
# Beispiel: zugang dann unter http://deine-domain/manage-x7k9p2
ADMIN_PATH=manage-x7k9p2

# --- E-Mail (SMTP) ---
# Default: Mailhog im selben Docker-Netz (UI: http://localhost:8025)
# Für echten Versand z.B. SendGrid / Postmark / Mailgun eintragen.
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=shop@example.com

# --- Business-Info (erscheint auf Rechnung + im Footer) ---
BUSINESS_NAME=Mein Service
BUSINESS_ADDRESS=Musterstr. 1, 12345 Musterstadt
BUSINESS_EMAIL=kontakt@example.com
BUSINESS_VAT=

# --- Crypto-Wallets ---
# Nur Adressen eintragen, die du auch akzeptierst. Leere Felder werden
# auf der Bestellseite NICHT angeboten.
CRYPTO_BTC_ADDRESS=
CRYPTO_ETH_ADDRESS=
CRYPTO_USDT_ADDRESS=
CRYPTO_XMR_ADDRESS=
CRYPTO_LTC_ADDRESS=
CRYPTO_SOL_ADDRESS=
